# Public DNS name pointing at the server. Use http://localhost for a local demo;
# for public deployment use https://credit.example.com.
APP_DOMAIN=http://localhost

# Bootstrap administrator created once when the database is empty.
BOOTSTRAP_ADMIN_NAME=System Administrator
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=CreditRisk@2026Secure

# Keep applicant registration enabled for a public demo; set false for a closed staff portal.
ALLOW_REGISTRATION=true

# auto follows the APP_DOMAIN scheme; set true to force secure cookies.
COOKIE_SECURE=auto

# Optional: provide a stable random secret (at least 32 characters). If omitted, the app creates one in its private data volume.
SESSION_SECRET=
FX_API_BASE_URL=https://api.frankfurter.dev/v2
